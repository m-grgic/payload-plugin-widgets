{
  "name": "payload-plugin-widgets",
  "version": "0.4.0",
  "description": "Payload CMS plugin for dashboard widgets: KPI figures, lists and charts that read from your collections, set up in the config or by whoever is looking.",
  "license": "MIT",
  "author": {
    "name": "Matija Grgić",
    "url": "https://heap-software.com"
  },
  "homepage": "https://github.com/m-grgic/payload-plugin-widgets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-grgic/payload-plugin-widgets.git"
  },
  "bugs": {
    "url": "https://github.com/m-grgic/payload-plugin-widgets/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "payload",
    "payloadcms",
    "payload-cms",
    "payload-plugin",
    "payload3",
    "payloadcms-plugin",
    "payload-cms-plugin",
    "payload-dashboard",
    "cms",
    "headless-cms",
    "plugin",
    "dashboard",
    "dashboard-widgets",
    "admin-dashboard",
    "admin-panel",
    "admin",
    "widgets",
    "widget",
    "charts",
    "chart",
    "bar-chart",
    "line-chart",
    "sparkline",
    "kpi",
    "metrics",
    "stats",
    "statistics",
    "reporting",
    "analytics",
    "aggregation",
    "postgres",
    "nextjs",
    "next.js",
    "react",
    "react-server-components",
    "typescript"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rsc": {
      "types": "./src/exports/rsc.ts",
      "default": "./src/exports/rsc.ts"
    },
    "./client": {
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    },
    "./widgets.css": "./src/widgets.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./rsc": {
        "types": "./dist/exports/rsc.d.ts",
        "default": "./dist/exports/rsc.js"
      },
      "./client": {
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./widgets.css": "./dist/widgets.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "cd dev && next dev",
    "dev:importmap": "cd dev && PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:importmap",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.90.0",
    "next": "^15.2.9 || ^16.0.0",
    "payload": "^3.90.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "graphql": "^16.8.1",
    "next": "^16.3.8",
    "payload": "^3.90.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "packageManager": "pnpm@11.5.0"
}
